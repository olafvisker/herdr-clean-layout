{
  "id": "root",
  "cloned_from": {
    "name": "Flat",
    "version": "0.1.18"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar-rail",
      "type": "column",
      "children": [
        {
          "id": "brand-rail",
          "type": "block",
          "content": {
            "mod": "my-workspace-chrome",
            "props": {
              "rail": true
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "rail-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces-rail",
              "type": "block",
              "content": {
                "mod": "my-spaces",
                "props": {
                  "rail": true
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents-rail",
              "type": "block",
              "content": {
                "mod": "my-agents",
                "props": {
                  "lines": true,
                  "rail": true
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        }
      ],
      "size": {
        "px": 52
      },
      "min": 52,
      "max": 52,
      "hidden": true,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "my-workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "my-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "my-agents",
                "props": {
                  "lines": true
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "my-workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          },
          "hidden": true
        }
      ],
      "size": {
        "px": 268
      },
      "min": 177,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs",
            "props": {
              "lines": true
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "my-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 0,
                    "color": "border"
                  },
                  "radius": 0,
                  "gap": 0,
                  "lone": true
                }
              },
              "background": "background"
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "my-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "my-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "hidden": true
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "clean-dark",
  "colors": {
    "canvas": "#0a0a0a",
    "chrome": "#0a0a0a",
    "background": "#111111",
    "surface": "#111111"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "link_handlers": [
    "my-files"
  ]
}